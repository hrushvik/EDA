      "cell_type": "code",
      "source": "import numpy as np\n\nname = ['hrushvik', 'bob', 'anirudh', 'ram']\nage = [25, 22, 21, 23]\nweight = [55.5, 77.7, 88.8, 55.5]\n\ndata = np.zeros(\n    4,\n    dtype={\n        'names': ('name', 'age', 'weight'),\n        'formats': ('U10', 'i4', 'f8')\n    }\n)\n\nprint(\"Structured array using a compound data type\")\nprint(data.dtype)\n\ndata['name'] = name\ndata['age'] = age\ndata['weight'] = weight\n\nprint(\"\\nFilled structured array\")\nprint(data)\n\nprint(\"\\nAll names\")\nprint(data['name'])\n\nprint(\"\\nFirst row of data\")\nprint(data[0])\n\nprint(\"\\nName from the last row\")\nprint(data[-1]['name'])\n\nprint(\"\\nNames where age is under 22\")\nprint(data[data['age'] < 22]['name'])\n\n# Other ways to define the same structured dtype\nprint(\"\\nUsing a list of tuples:\")\nprint(np.dtype([\n    ('name', 'U10'),\n    ('age', 'i4'),\n    ('weight', 'f8')\n]))\n\nprint(\"\\nUsing a string:\")\nprint(np.dtype('U10,i4,f8'))\ntp = np.dtype([\n    ('id','i8'),\n    ('mat','f8',(3,3))\n])\nX = np.zeros(1,dtype=tp)\nprint(X[0])\nprint(X['mat'][0])",
